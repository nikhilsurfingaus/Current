# Copy to .env and adjust for local Docker runs (optional — defaults work for dev).
# Never commit .env with real production secrets.

POSTGRES_USER=current
POSTGRES_PASSWORD=current
POSTGRES_DB=CurrentDb

JWT_ISSUER=Current.Api
JWT_AUDIENCE=Current.Client
JWT_KEY=change-me-to-a-long-random-secret-at-least-32-chars

API_PORT=5231
UI_PORT=4200

# Production (Neon) — set in shell or Render dashboard, NOT in this file when committing:
# ConnectionStrings__DefaultConnection=Host=ep-xxx.neon.tech;Database=neondb;Username=...;Password=...;SSL Mode=Require;Trust Server Certificate=true
